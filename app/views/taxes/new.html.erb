<h1>Income tax calculator</h1>

<%= form_with url: tax_path, method: :post do |f| %>
  <p>
    <%= f.label :country, "Country" %>
    <%= f.select :country, @regimes.map { [_1.name, _1.code] }, selected: params[:country] %>
  </p>
  <p>
    <%= f.label :income, "Annual income" %>
    <%= f.number_field :income, value: params[:income], min: 0, step: "0.01", required: true %>
  </p>
  <p>
    <%= f.label :date, "Income date" %>
    <%= f.date_field :date, value: params[:date].presence || Date.current %>
  </p>
  <%= f.submit "Calculate" %>
<% end %>

<% if @error %>
  <p class="error"><%= @error %></p>
<% end %>

<% if @assessment %>
  <% cur = @regime.currency %>
  <h2>Result</h2>
  <p>Rates in force from <%= l(@regime.effective_from, format: :long) %></p>
  <dl>
    <dt>Tax</dt><dd><%= number_to_currency(@assessment.tax_payable, unit: "#{cur} $") %></dd>
    <dt>Net income</dt><dd><%= number_to_currency(@assessment.net_income, unit: "#{cur} $") %></dd>
    <dt>Effective rate</dt><dd><%= number_to_percentage(@assessment.effective_rate * 100, precision: 2) %></dd>
  </dl>
  <table>
    <tr><th>Levy</th><th>Rate</th><th>Taxable</th><th>Tax</th></tr>
    <% @assessment.charges.each do |charge| %>
      <tr>
        <td><%= charge.label %></td>
        <td><%= number_to_percentage(charge.rate * 100, precision: 2, strip_insignificant_zeros: true) %></td>
        <td><%= number_to_currency(charge.taxable_amount) %></td>
        <td><%= number_to_currency(charge.amount) %></td>
      </tr>
    <% end %>
  </table>
<% end %>
